APP_ENV=prod
NEXT_PUBLIC_APP_ENV=prod

# ---- Supabase (production only) ----
NEXT_PUBLIC_SUPABASE_URL_PROD=
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=
SUPABASE_SERVICE_ROLE_KEY_PROD=

# App URL and optional email provider
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENABLE_RESEND=false
RESEND_API_KEY=
RESEND_EMAIL_FROM=

# Master key for AES-256-GCM encryption of stored API credentials (Finnhub etc.)
# Must be base64 of 32 raw bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates all previously stored api_keys rows.
APP_ENCRYPTION_KEY=

# Shared secret used when server actions call the Supabase Edge function.
# Must match EDGE_FN_SECRET on stock edge functions (collect-stock-data, import-candidates-data, update-stock-data).
EDGE_FN_SECRET=

# ---- MWS Chat backends (server only; never expose to clients) ----
# Provider: auto (default) | google_studio | modal
# auto = Google free tier first; on quota/limit/error, silent failover to Modal own model.
# MWS_CHAT_PROVIDER=auto
#
# Google AI Studio — free Gemini (used first in auto mode)
# GOOGLE_STUDIO_AI_API_KEY=
# GOOGLE_STUDIO_AI_MODEL=gemini-3.5-flash-lite
#
# Own Modal AI (OpenAI-compatible) — DeepSeek fallback / production model
# MODAL_PROXY_TOKEN_ID=
# MODAL_PROXY_TOKEN_SECRET=
# MODAL_CHAT_BASE_URL=https://adnanadilalpha--ep-mws-ai-server.us-west.modal.direct/v1
# MODAL_CHAT_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
#
# Legacy Modal URL + single API key (still supported)
# MODAL_CHAT_URL=https://your-modal-endpoint.modal.run/v1/chat/completions
# MODAL_CHAT_API_KEY=
