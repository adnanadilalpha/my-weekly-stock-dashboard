APP_ENV=dev
NEXT_PUBLIC_APP_ENV=dev

# Optional safety override for local production testing.
# Keep false/empty for normal development.
ALLOW_PROD_FROM_LOCAL=false

# ---- Dev project (used when APP_ENV=dev) ----
NEXT_PUBLIC_SUPABASE_URL_DEV=
NEXT_PUBLIC_SUPABASE_ANON_KEY_DEV=
SUPABASE_SERVICE_ROLE_KEY_DEV=

# ---- Production project (used when APP_ENV=prod) ----
NEXT_PUBLIC_SUPABASE_URL_PROD=
NEXT_PUBLIC_SUPABASE_ANON_KEY_PROD=
SUPABASE_SERVICE_ROLE_KEY_PROD=

# App URL and optional email provider
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENABLE_RESEND=false
RESEND_API_KEY=
RESEND_EMAIL_FROM=

# Master key for AES-256-GCM encryption of stored API credentials (Finnhub etc.)
# Must be base64 of 32 raw bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates all previously stored api_keys rows.
APP_ENCRYPTION_KEY=

# Shared secret used when server actions call the Supabase Edge function.
# Must match EDGE_FN_SECRET on stock edge functions (collect-stock-data, import-candidates-data, update-stock-data).
EDGE_FN_SECRET=
